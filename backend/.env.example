# Variáveis de Ambiente — QUATTRO Logística Backend
# NUNCA versionar este arquivo com valores reais

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://quattro_user:sua_senha_aqui@localhost:5432/quattro_logistica

# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gere um secret seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=gere_um_secret_de_64_chars_aleatorio_aqui

# ─── APIs de Integração ───────────────────────────────────────────────────────
CPF_API_BASE_URL=https://base4.sistemafullativo.online:81/api/cpf-cnpj
CPF_API_TOKEN=118D0C595D

CEP_API_BASE_URL=https://base2.sistemafullativo.online:80/api/cep1
# Fallback opcional (deixe em branco para desativar)
VIACEP_FALLBACK=true

# ─── SuperFrete ───────────────────────────────────────────────────────────────
SUPERFRETE_API_URL=https://superfrete.com/api/v0
SUPERFRETE_API_TOKEN=seu_token_superfrete_aqui
SUPERFRETE_WEBHOOK_SECRET=seu_secret_webhook_superfrete_aqui
# ID do remetente configurado no painel SuperFrete
SUPERFRETE_FROM_ID=seu_id_remetente_aqui

# ─── Payt ─────────────────────────────────────────────────────────────────────
PAYT_API_URL=https://api.payt.com.br/v1
PAYT_API_TOKEN=seu_token_payt_aqui
PAYT_WEBHOOK_SECRET=seu_secret_webhook_payt_aqui

# ─── E-mail ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu@email.com
EMAIL_PASSWORD=sua_senha_de_app_gmail
EMAIL_FROM_NAME=QUATTRO Logística
EMAIL_FROM_ADDRESS=noreply@quattrologistica.com.br

# ─── Postback ─────────────────────────────────────────────────────────────────
# Gere um secret seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTBACK_SIGNING_SECRET=gere_um_secret_aleatorio_aqui

# ─── Upload de Arquivos ───────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# ─── Segurança ────────────────────────────────────────────────────────────────
# Link temporário de arquivo (em minutos)
FILE_LINK_EXPIRY_MINUTES=60
# Máximo de tentativas de login por IP (por 15 minutos)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
